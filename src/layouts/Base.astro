---
import '../styles/global.css';
const {title='Khaled Tlili',description='Software engineering, architecture and continuous learning.'}=Astro.props;
const canonical=new URL(Astro.url.pathname,Astro.site);
---
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="description" content={description}/><title>{title}</title><link rel="canonical" href={canonical.href}/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical.href}/><meta property="og:type" content="website"/><meta property="og:image" content="https://khaledtlili.dev/og.svg"/><meta name="twitter:card" content="summary"/><link rel="alternate" type="application/rss+xml" title="Engineering journal" href="/rss.xml"/><script is:inline>try{document.documentElement.dataset.theme=localStorage.getItem('theme')||'dark'}catch{}</script></head><body><a class="skip" href="#main">Skip to content</a><header><nav><a class="brand" href="/">kt<span>.</span></a><div class="navlinks"><a href="/">Home</a><a href="/blog/">Writing</a><a href="/projects/">Projects</a><a href="/about/">About</a><a href="/lab/">Lab</a><a href="/contact/">Contact</a><button id="theme" aria-label="Toggle color theme">☼</button></div></nav></header><main id="main"><slot/></main><footer>© {new Date().getFullYear()} Khaled Tlili <a href="https://www.linkedin.com/in/khaled-tlili-85b887106/">LinkedIn ↗</a> <a href="/rss.xml">RSS</a></footer><script>document.querySelector('#theme')?.addEventListener('click',()=>{const next=document.documentElement.dataset.theme==='light'?'dark':'light';document.documentElement.dataset.theme=next;try{localStorage.setItem('theme',next)}catch{}});</script>{import.meta.env.PUBLIC_CF_ANALYTICS_TOKEN && <script is:inline defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={JSON.stringify({token:import.meta.env.PUBLIC_CF_ANALYTICS_TOKEN})}></script>}</body></html>