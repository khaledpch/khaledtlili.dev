---
import Base from '../../layouts/Base.astro';
import ArticleList from '../../components/ArticleList.astro';
import {getCollection} from 'astro:content';
const articles=(await getCollection('articles')).sort((a,b)=>b.data.date.valueOf()-a.data.date.valueOf());
const series=[...new Set(articles.map(a=>a.data.series).filter(Boolean))];
const categories=['All',...new Set(articles.map(a=>a.data.category))];
---
<Base title="Writing — Khaled Tlili"><div class="eyebrow">01 / Engineering journal</div><h1>Writing<span class="accent">.</span></h1><p>Notes on architecture, programming and building better software. Sample articles for review.</p><input id="search" type="search" aria-label="Search articles or tags" placeholder="Search articles or tags…"/><div class="tags">{categories.map(c=><button class="tag" data-filter={c} aria-pressed={c==='All'}>{c}</button>)}</div><div class="tags"><label for="series">Collection</label><select id="series"><option value="">All collections</option>{series.map(s=><option value={s}>{s}</option>)}</select></div><ArticleList articles={articles}/><p id="empty" hidden>No matching articles.</p></Base><script>import Fuse from 'fuse.js';let category='All';const input=document.querySelector<HTMLInputElement>('#search');const rows=[...document.querySelectorAll<HTMLElement>('.article')];const series=document.querySelector<HTMLSelectElement>('#series');const fuse=new Fuse(rows.map((r,i)=>({i,body:r.dataset.search??''})),{keys:['body'],threshold:.3,ignoreLocation:true});series?.addEventListener('change',filter);function filter(){const q=input?.value.toLowerCase()??'';const hits=new Set(q?fuse.search(q).map(x=>x.item.i):rows.map((_,i)=>i));for(const [i,r] of rows.entries())r.hidden=!(category==='All'||r.dataset.category===category)||!hits.has(i)||!!(series?.value&&r.dataset.series!==series.value);const empty=document.querySelector<HTMLElement>('#empty');if(empty)empty.hidden=rows.some(r=>!r.hidden);}input?.addEventListener('input',filter);document.querySelectorAll<HTMLButtonElement>('[data-filter]').forEach(b=>b.addEventListener('click',()=>{category=b.dataset.filter??'All';document.querySelectorAll('[data-filter]').forEach(x=>x.setAttribute('aria-pressed',String(x===b)));filter()}));const tag=new URLSearchParams(location.search).get('tag');if(tag&&input){input.value=tag;filter();}</script>