---
import Terminal from '../components/Terminal.astro';
import GithubActivity from '../components/GithubActivity.astro';
import Base from '../layouts/Base.astro';
import ArticleList from '../components/ArticleList.astro';
import {getCollection} from 'astro:content';
const articles=(await getCollection('articles')).sort((a,b)=>b.data.date.valueOf()-a.data.date.valueOf());
---
<Base><section class="hero"><div class="portrait" aria-label="Profile photo placeholder">KT</div><div class="eyebrow">Frankfurt, Germany · Khaled Tlili</div><h1>Building software.<br/><span class="muted">Thinking in systems.</span></h1><p>Senior Software Developer at CHECK24. I explore software architecture, build reliable systems, and share what I learn along the way.</p><div class="actions"><a class="btn primary" href="/blog/">Explore my writing ↗</a><a class="btn" href="/cv.pdf" download>Download CV ↓</a></div></section><div class="metrics"><div><strong>~9</strong><span class="eyebrow">Years in engineering (2026)</span></div><div><strong>04</strong><span class="eyebrow">Companies</span></div><div><strong>02</strong><span class="eyebrow">Countries</span></div></div><section class="section"><h2>Latest writing<span class="accent">.</span></h2><ArticleList articles={articles.slice(0,3)}/></section><section class="section"><h2>Selected ideas<span class="accent">.</span></h2><div class="grid"><a class="panel" href="/projects/#domain">Domain Architecture Lab</a><a class="panel" href="/projects/#infra">Infrastructure Playground</a><a class="panel" href="/projects/#web">Modern Web Starter</a></div></section><section class="section"><h2>Explore my profile</h2><Terminal/></section><GithubActivity/></Base>