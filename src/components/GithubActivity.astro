<section class="section"><h2>Open-source activity<span class="accent">.</span></h2><p id="github-status" aria-live="polite">Public repositories on GitHub.</p><div id="github-repos" class="grid"></div><a class="btn" href="https://github.com/khaledpch">View GitHub profile ↗</a></section><script>const box=document.querySelector('#github-repos')!;const status=document.querySelector('#github-status')!;fetch('https://api.github.com/users/khaledpch/repos?sort=updated&per_page=6',{credentials:'omit'}).then(r=>{if(!r.ok)throw Error();return r.json()}).then(repos=>{for(const repo of repos){const a=document.createElement('a');a.className='panel';a.href='https://github.com/khaledpch/'+encodeURIComponent(repo.name);const title=document.createElement('strong');title.textContent=repo.name;const p=document.createElement('p');p.textContent=repo.description||'Public repository';const meta=document.createElement('small');meta.textContent=(repo.language||'Code')+' · ★ '+repo.stargazers_count;a.append(title,p,meta);box.append(a)}status.textContent=repos.length?'Recently updated public repositories':'No public repositories returned.'}).catch(()=>{status.textContent='GitHub activity temporarily unavailable. Visit the profile directly.'});</script>