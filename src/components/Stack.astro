---
import {siPhp,siSymfony,siTypescript,siReact,siMysql,siRedis,siDocker,siJenkins,siGrafana} from 'simple-icons';
const icons=[siPhp,siSymfony,siTypescript,siReact,siMysql,siRedis,siDocker,siJenkins,siGrafana];
---
<div class="tags">{icons.map(i=><span class="tag"><svg class="stack-icon" viewBox="0 0 24 24" aria-hidden="true"><path d={i.path}/></svg>{i.title}</span>)}<span class="tag">DDD</span></div>