<div class="panel"><label for="diagram-type">Architecture scenario</label><select id="diagram-type"><option value="ddd">Domain-driven design</option><option value="queue">Asynchronous processing</option></select><div class="mermaid-output" id="diagram-output" aria-live="polite">API → Application → Domain</div></div><script>const select=document.querySelector<HTMLSelectElement>('#diagram-type');const target=document.querySelector('#diagram-output');const diagrams:Record<string,string>={ddd:'flowchart TD\n API --> UseCase\n UseCase --> Domain\n Adapter --> Domain',queue:'flowchart LR\n Client --> API\n API --> Queue\n Queue --> Worker\n Worker --> Database'};let version=0;async function draw(){if(!target)return;const n=++version;try{const {default:mermaid}=await import('mermaid');mermaid.initialize({startOnLoad:false,securityLevel:'strict',theme:'neutral'});const result=await mermaid.render('diagram-'+n,diagrams[select?.value??'ddd']);if(n===version)target.innerHTML=result.svg}catch{target.textContent='Diagram unavailable.'}}select?.addEventListener('change',draw);draw();</script>