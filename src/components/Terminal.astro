<section class="panel terminal"><div class="eyebrow">khaled@dev · interactive terminal</div><pre id="terminal-output" aria-live="polite">Welcome. Type help to explore.</pre><form id="terminal-form"><label for="command">$</label><input id="command" autocomplete="off" placeholder="whoami"/><button>Run</button></form><div class="tags">{['whoami','skills','experience','help','clear'].map(c=><button type="button" data-command={c}>{c}</button>)}</div></section><script>const commands:Record<string,string>={whoami:'Khaled Tlili — Senior Software Developer at CHECK24, Frankfurt',skills:'PHP · Symfony · React · TypeScript · Docker · Jenkins · DDD',experience:'2023–present CHECK24\n2020–2023 Sofrecom\n2019–2020 Tunafanya\n2017–2019 Tunisia International Technology',help:'whoami, skills, experience, help, clear'};const out=document.querySelector('#terminal-output')!;const input=document.querySelector<HTMLInputElement>('#command')!;function run(raw:string){const c=raw.trim().toLowerCase();if(c==='clear'){out.textContent='';return;}if(c)out.textContent+='\n$ '+c+'\n'+(Object.hasOwn(commands,c)?commands[c]:'Command not found. Type help.');out.scrollTop=out.scrollHeight;}document.querySelector('#terminal-form')?.addEventListener('submit',e=>{e.preventDefault();run(input.value);input.value=''});document.querySelectorAll<HTMLButtonElement>('[data-command]').forEach(b=>b.addEventListener('click',()=>run(b.dataset.command??'')));</script>